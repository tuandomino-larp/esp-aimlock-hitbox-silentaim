--[[
    Tuandomino Hack
    ESP + Silent Aim + AimLock + Hitbox
    target: Roblox (Delta executor, mobile)
    unload: getgenv().TD_Unload() or re-execute
]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui    = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera
local Mouse       = LocalPlayer:GetMouse()

--// ===== SETTINGS =====
local SETTINGS = {
    ESP           = true,
    SilentAim     = true,
    AimLock       = false,
    Hitbox        = false,
    TeamCheck     = false,
    AimPart       = "Head",
    FOV           = 250,
    AimSmoothness = 0.25,
    HitboxScale   = 2.0,
    ShowHitbox    = false,
    ESPColor      = Color3.fromRGB(0, 255, 255),
    TextColor     = Color3.fromRGB(255, 255, 255),
    HealthColor   = Color3.fromRGB(0, 255, 0),
}

local HITBOX_PARTS = {
    Head = true,
    Torso = true,
    UpperTorso = true,
    LowerTorso = true,
    HumanoidRootPart = true,
}

--// ===== STATE =====
if getgenv().TD_Unload then pcall(getgenv().TD_Unload) end

local Connections  = {}
local ESPCache     = {}
local Running      = true
local CachedTarget = nil
local HoldingAim   = false

local function addConn(c) table.insert(Connections, c); return c end

--// ===== ESP =====
local function newESP(plr)
    if plr == LocalPlayer or ESPCache[plr] then return end
    local box  = Drawing.new("Square")
    local name = Drawing.new("Text")
    local dist = Drawing.new("Text")
    local hp   = Drawing.new("Square")
    box.Thickness, box.Filled, box.Visible = 1, false, false
    name.Size, name.Center, name.Outline, name.Visible = 14, true, true, false
    dist.Size, dist.Center, dist.Outline, dist.Visible = 12, true, true, false
    hp.Thickness, hp.Filled, hp.Visible = 1, true, false
    ESPCache[plr] = { box = box, name = name, dist = dist, hp = hp }
end

local function removeESP(plr)
    local e = ESPCache[plr]
    if not e then return end
    for _, obj in pairs(e) do pcall(function() obj:Remove() end) end
    ESPCache[plr] = nil
end

local function hideAll(e)
    e.box.Visible, e.name.Visible, e.dist.Visible, e.hp.Visible = false, false, false, false
end

local function updateESP()
    for plr, e in pairs(ESPCache) do
        if not SETTINGS.ESP then hideAll(e); continue end
        local char = plr.Character
        if not char then hideAll(e); continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hum or not root or not head or hum.Health <= 0 then hideAll(e); continue end
        if SETTINGS.TeamCheck and plr.Team == LocalPlayer.Team then hideAll(e); continue end

        local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local botPos, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        if not (topOn and botOn) then hideAll(e); continue end

        local h = math.abs(botPos.Y - topPos.Y)
        local w = h * 0.55
        local x = topPos.X - w / 2
        local y = topPos.Y

        e.box.Size, e.box.Position, e.box.Color, e.box.Visible =
            Vector2.new(w, h), Vector2.new(x, y), SETTINGS.ESPColor, true

        e.name.Text     = plr.Name
        e.name.Position = Vector2.new(topPos.X, y - 16)
        e.name.Color    = SETTINGS.TextColor
        e.name.Visible  = true

        local dStuds = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
        e.dist.Text     = tostring(dStuds) .. "m"
        e.dist.Position = Vector2.new(topPos.X, y + h + 2)
        e.dist.Color    = SETTINGS.TextColor
        e.dist.Visible  = true

        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local barH  = h * ratio
        e.hp.Size     = Vector2.new(2, barH)
        e.hp.Position = Vector2.new(x - 4, y + (h - barH))
        e.hp.Color    = SETTINGS.HealthColor
        e.hp.Visible  = true
    end
end

--// ===== TARGET SELECTION =====
local function pickTarget()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local best, bestDist = nil, SETTINGS.FOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if SETTINGS.TeamCheck and plr.Team == LocalPlayer.Team then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local part = char:FindFirstChild(SETTINGS.AimPart) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < bestDist then bestDist, best = d, part end
    end
    return best
end

--// ===== SILENT AIM HOOK =====
local mt       = getrawmetatable(game)
local oldIndex = mt.__index
local oldCall  = mt.__namecall
setreadonly(mt, false)

mt.__index = newcclosure(function(self, key)
    if Running and SETTINGS.SilentAim and self == Mouse and CachedTarget then
        if key == "Hit"    then return CFrame.new(CachedTarget.Position) end
        if key == "Target" then return CachedTarget end
        if key == "UnitRay" then
            return Ray.new(Camera.CFrame.Position, (CachedTarget.Position - Camera.CFrame.Position).Unit * 5000)
        end
    end
    return oldIndex(self, key)
end)

mt.__namecall = newcclosure(function(self, ...)
    if Running and SETTINGS.SilentAim and CachedTarget then
        local m = getnamecallmethod()
        if m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRayWithWhitelist" then
            local args   = { ... }
            local origin = Camera.CFrame.Position
            args[1] = Ray.new(origin, (CachedTarget.Position - origin).Unit * 5000)
            return oldCall(self, table.unpack(args))
        end
    end
    return oldCall(self, ...)
end)

setreadonly(mt, true)

--// ===== AIMLOCK =====
local function updateAimlock()
    if not SETTINGS.AimLock or not HoldingAim or not CachedTarget then return end
    local camPos  = Camera.CFrame.Position
    local desired = CFrame.lookAt(camPos, CachedTarget.Position)
    Camera.CFrame = Camera.CFrame:Lerp(desired, SETTINGS.AimSmoothness)
end

--// ===== HITBOX =====
local function applyHitbox(plr)
    local char = plr.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and HITBOX_PARTS[part.Name] then
            if not part:GetAttribute("TD_OrigSize") then
                part:SetAttribute("TD_OrigSize", part.Size)
                if SETTINGS.ShowHitbox then
                    part:SetAttribute("TD_OrigTrans", part.Transparency)
                    part.Transparency = 0.6
                end
            end
            if part:GetAttribute("TD_AppliedScale") ~= SETTINGS.HitboxScale then
                part.Size = part:GetAttribute("TD_OrigSize") * SETTINGS.HitboxScale
                part:SetAttribute("TD_AppliedScale", SETTINGS.HitboxScale)
            end
        end
    end
end

local function restoreHitbox(plr)
    local char = plr.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part:GetAttribute("TD_OrigSize") then
            part.Size = part:GetAttribute("TD_OrigSize")
            part:SetAttribute("TD_OrigSize", nil)
            part:SetAttribute("TD_AppliedScale", nil)
            if part:GetAttribute("TD_OrigTrans") ~= nil then
                part.Transparency = part:GetAttribute("TD_OrigTrans")
                part:SetAttribute("TD_OrigTrans", nil)
            end
        end
    end
end

local function updateHitbox()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if SETTINGS.TeamCheck and plr.Team == LocalPlayer.Team then continue end
        if SETTINGS.Hitbox then applyHitbox(plr) else restoreHitbox(plr) end
    end
end

