local function makeToggle(key, label, y)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 30)
    btn.Position = UDim2.new(0, 4, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 36)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local function refresh()
        btn.Text = label .. ": " .. (SETTINGS[key] and "ON" or "OFF")
        btn.TextColor3 = SETTINGS[key]
            and Color3.fromRGB(120, 255, 120)
            or Color3.fromRGB(255, 120, 120)
    end
    refresh()
    btn.MouseButton1Click:Connect(function() SETTINGS[key] = not SETTINGS[key]; refresh() end)
end

local function makeStepper(label, key, step, min, max, y, fmt)
    fmt = fmt or function(v) return tostring(v) end
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 30)
    row.Position = UDim2.new(0, 4, 0, y)
    row.BackgroundColor3 = Color3.fromRGB(32, 32, 36)
    row.BorderSizePixel = 0
    row.Parent = scroll
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 32, 1, 0)
    minus.BackgroundTransparency = 1
    minus.Text = "-"
    minus.TextColor3 = Color3.fromRGB(255, 100, 100)
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 18
    minus.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -64, 1, 0)
    lbl.Position = UDim2.new(0, 32, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.Parent = row

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 32, 1, 0)
    plus.Position = UDim2.new(1, -32, 0, 0)
    plus.BackgroundTransparency = 1
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(100, 255, 100)
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 18
    plus.Parent = row

    local function refresh() lbl.Text = label .. ": " .. fmt(SETTINGS[key]) end
    refresh()
    minus.MouseButton1Click:Connect(function()
        SETTINGS[key] = math.max(min, SETTINGS[key] - step); refresh()
    end)
    plus.MouseButton1Click:Connect(function()
        SETTINGS[key] = math.min(max, SETTINGS[key] + step); refresh()
    end)
end

makeToggle("ESP",       "ESP",        4)
