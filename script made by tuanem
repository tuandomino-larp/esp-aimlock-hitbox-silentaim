--// ===== WIRING =====
for _, plr in ipairs(Players:GetPlayers()) do newESP(plr) end
addConn(Players.PlayerAdded:Connect(newESP))
addConn(Players.PlayerRemoving:Connect(removeESP))

addConn(RunService.RenderStepped:Connect(function()
    if not Running then return end
    updateESP()
    CachedTarget = pickTarget()
    updateAimlock()
    updateHitbox()
end))

--// ===== CLEANUP =====
getgenv().TD_Unload = function()
    Running = false
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    for plr in pairs(ESPCache) do removeESP(plr) end
    for _, plr in ipairs(Players:GetPlayers()) do restoreHitbox(plr) end
    pcall(function() screen:Destroy() end)
    setreadonly(mt, false)
    mt.__index    = oldIndex
    mt.__namecall = oldCall
    setreadonly(mt, true)
end

print("[Tuandomino Hack] loaded — panel top-left, AIM button bottom-right")
